							"    // Guarda el UUID en una variable de entorno",
							"    pm.environment.set(\"supplier_uuid\", responseData.uuid);",
							"    console.log(\"✅ UUID guardado en entorno:\", responseData.uuid);",
							"} else {",
							"    console.warn(\"⚠️ No se encontró UUID en el response\");",
