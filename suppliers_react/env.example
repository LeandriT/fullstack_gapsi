# Variables de entorno para el proyecto React
# Copiar este archivo como .env.local y ajustar los valores según sea necesario

# URL del API del backend
VITE_API_URL=http://localhost:8080/api/v1

# Configuración de desarrollo
VITE_DEV_MODE=true

# Configuración de producción (ejemplo)
# VITE_API_URL=https://your-api-domain.com/api/v1
# VITE_DEV_MODE=false
